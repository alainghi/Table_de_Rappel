<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/papier"
        android:scaleType="centerCrop"
        android:alpha="0.9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnChercherNumeros"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChercherNumeros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Chercher_numero"
        android:contentDescription="@string/Chercher_numero"
        android:layout_marginBottom="16dp"
        app:icon="@drawable/ic_numbers"
        app:iconGravity="start"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/btnChercherMots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="300dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChercherMots"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Chercher_mots"
        android:contentDescription="@string/Chercher_mots"
        android:layout_marginBottom="16dp"
        app:icon="@drawable/ic_words"
        app:iconGravity="start"
        app:layout_constraintTop_toBottomOf="@id/btnChercherNumeros"
        app:layout_constraintBottom_toTopOf="@id/btnVoirImages"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="300dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoirImages"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/Voir_images"
        android:contentDescription="@string/Voir_images"
        app:icon="@drawable/ic_images"
        app:iconGravity="start"
        app:layout_constraintTop_toBottomOf="@id/btnChercherMots"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="300dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>